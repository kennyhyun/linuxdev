# linuxdev .env sample -- copy to .env and edit, or let `setup.ps1 -wsl` fill it.
# setup.ps1 -wsl asks for the values below on first run and saves them here.

# ---- WSL2 host settings (-> %USERPROFILE%\.wslconfig; GLOBAL to all distros) ----
MEMORY=4096                 # WSL2 memory limit (MB)
CPUS=4                      # WSL2 processor count
WSL_AUTO_RECLAIM=gradual    # gradual | dropcache | disabled
WSL_KEEP_ALIVE=1           # 1 keeps distro running w/o a session (runner host); 0 to disable
WSL_SWAP=0                  # swap size (MB); 0 to disable

# ---- data volume sizes (-> vhdx; dynamic, SIZE = max cap, INIT = preallocated) ----
# SIZE_GB is the vhdx max (sparse). INIT_GB preallocates real blocks right after
# format (via fallocate) so the volume does not pay the "grow on first write"
# penalty later. INIT_GB=0 disables preallocation. INIT_GB must be <= SIZE_GB.
DATA_SIZE_GB=64            # data.vhdx max: holds /var and /home (incl /home/linuxbrew)
DATA_INIT_GB=24           # data.vhdx preallocated size
DOCKER_SIZE_GB=64         # docker.vhdx max: /var/lib/docker
DOCKER_INIT_GB=48         # docker.vhdx preallocated size

# ---- distro settings (-> /etc/wsl.conf, user, shell rc, /etc/hosts) ----
WSL_USERNAME=linuxdev       # default Linux user (created with UID 1000)
NAME=linuxdev               # Linux hostname inside the distro
WSL_CONTAINER_RUNTIME=docker # docker | microk8s | both | none  (kubectl always installed)
DOTFILES_REPO=              # optional dotfiles git url (blank to skip)

# ---- injected into the distro user's shell rc (export __VM__X -> X) ----
# __VM__PROJECT_DIR=~/Projects
# __VM__COMPOSE_VERSION=1.29.2

# ---- injected into /etc/hosts (__VMHOSTS__<ip-with-underscores>=hostname) ----
# __VMHOSTS__127_0_0_1=localstack
# __VMHOSTS__127_0_0_1=kiosk.whitechstage.com

# ---- optional: GitLab Runner (used by scripts/wsl/register-runner.ps1) ----
# RUNNER_TOKEN=glrt-xxxxxxxxxxxx   # GitLab 16+ runner authentication token
# RUNNER_URL=https://gitlab.imaginetoolbox.com
# RUNNER_TAGS=linux,localstack,runner
# RUNNER_NAME=wsl2-runner
