[Unit]
Description=Linuxdev WSL boot tasks (protect rootfs read-only)
# Run after systemd has finished writing to /etc and /usr so the read-only
# remount does not race with early boot writes (machine-id, tmpfiles, etc.).
# Data volumes (/mnt/data, /var, /home, /var/lib/docker) are mounted by
# dedicated systemd .mount units, not here.
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Make system dirs (/usr /bin /sbin /lib /lib64 /etc /opt /srv) read-only to
# survive forced shutdowns. Use 'sudo rootfs-rw' to unlock for package
# installs, then 'sudo rootfs-ro' to re-lock.
ExecStart=/usr/local/lib/linuxdev/rootfs-ro.sh

[Install]
WantedBy=multi-user.target
